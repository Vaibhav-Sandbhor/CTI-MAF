{
  "name": "sentrax-desktop",
  "productName": "SentraX",
  "description": "SentraX - Cyber Threat Intelligence Platform",
  "private": true,
  "version": "1.0.0",
  "author": "SentraX Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "npx cross-env NODE_ENV=development npx electron .",
    "electron:dev": "npx concurrently \"npm run dev\" \"npx wait-on http://localhost:5173 && npm run electron\"",
    "electron:build": "npm run build && npx electron-builder --publish never",
    "electron:build:linux": "npm run build && npx electron-builder --linux --publish never",
    "electron:build:win": "set CSC_IDENTITY_AUTO_DISCOVERY=false && set CSC_LINK= && set CSC_KEY_PASSWORD= && npm run build && npx electron-builder --win --publish never",
    "electron:build:mac": "npm run build && npx electron-builder --mac --publish never"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "31.0.0",
    "electron-builder": "24.13.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.sentrax.app",
    "productName": "SentraX",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../start_server.py",
        "to": "backend/start_server.py"
      },
      {
        "from": "../api_server.py",
        "to": "backend/api_server.py"
      },
      {
        "from": "../requirements.txt",
        "to": "backend/requirements.txt"
      },
      {
        "from": "../orchestrator.py",
        "to": "backend/orchestrator.py"
      },
      {
        "from": "../database",
        "to": "backend/database"
      },
      {
        "from": "../auth",
        "to": "backend/auth"
      },
      {
        "from": "../ransomware_module",
        "to": "backend/ransomware_module"
      },
      {
        "from": "../honeypot",
        "to": "backend/honeypot"
      },
      {
        "from": "../portscan_module",
        "to": "backend/portscan_module"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "public/icon.png",
      "maintainer": "CyberSIEM Team"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icons/icon.ico",
      "sign": false,
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
